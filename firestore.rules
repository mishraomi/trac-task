rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(list) { return signedIn() && list.ownerId == request.auth.uid; }
    function access(list) { return list.memberAccess[request.auth.uid]; }
    function canRead(list) { return owns(list) || access(list) in ['all', 'edit', 'read']; }
    function canWrite(list) { return owns(list) || access(list) in ['all', 'edit']; }
    function canDelete(list) { return owns(list) || access(list) == 'all'; }
    function validPrivateList(data) {
      return data.ownerId == request.auth.uid
        && data.memberIds.size() == 1
        && data.memberIds[0] == request.auth.uid
        && data.memberRoles[request.auth.uid] == 'owner'
        && data.memberAccess[request.auth.uid] == 'all';
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;
    }
    match /lists/{listId} {
      allow create: if signedIn() && validPrivateList(request.resource.data);
      allow read: if canRead(resource.data);
      allow update: if canWrite(resource.data);
      allow delete: if owns(resource.data);
      match /tasks/{taskId} {
        allow read: if canRead(get(/databases/$(database)/documents/lists/$(listId)).data);
        allow create, update: if canWrite(get(/databases/$(database)/documents/lists/$(listId)).data);
        allow delete: if canDelete(get(/databases/$(database)/documents/lists/$(listId)).data);
      }
    }
  }
}
