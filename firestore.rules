rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(list) { return signedIn() && list.ownerId == request.auth.uid; }
    function isMember(list) { return signedIn() && request.auth.uid in list.memberIds; }
    function access(list) { return list.memberAccess[request.auth.uid]; }
    function canRead(list) { return owns(list) || isMember(list); }
    function canEditTasks(list) { return owns(list) || access(list) == 'edit'; }
    function validAuditEvent(data) {
      return data.keys().hasAll([
          'taskId', 'taskTitle', 'action', 'actorId', 'actorName', 'occurredAt', 'changes'
        ])
        && data.keys().hasOnly([
          'taskId', 'taskTitle', 'action', 'actorId', 'actorName', 'occurredAt', 'changes'
        ])
        && data.taskId is string
        && data.taskTitle is string
        && data.action in ['created', 'updated', 'completed', 'reopened', 'deleted']
        && data.actorId == request.auth.uid
        && data.actorName is string
        && data.occurredAt is timestamp
        && data.occurredAt == request.time
        && data.changes is list;
    }
    function validPrivateList(data) {
      return data.ownerId == request.auth.uid
        && data.memberIds.size() == 1
        && data.memberIds[0] == request.auth.uid
        && data.memberRoles[request.auth.uid] == 'owner'
        && data.memberAccess.size() == 0;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;
    }
    match /lists/{listId} {
      allow create: if signedIn() && validPrivateList(request.resource.data);
      allow read: if canRead(resource.data);
      allow update: if owns(resource.data);
      allow delete: if owns(resource.data);
      match /tasks/{taskId} {
        allow read: if canRead(get(/databases/$(database)/documents/lists/$(listId)).data);
        allow create, update, delete: if canEditTasks(get(/databases/$(database)/documents/lists/$(listId)).data);
      }
      match /auditEvents/{eventId} {
        allow read: if canRead(get(/databases/$(database)/documents/lists/$(listId)).data);
        allow create: if canEditTasks(get(/databases/$(database)/documents/lists/$(listId)).data)
          && validAuditEvent(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
